# Environment Configuration
ENV=development
PROJECT_NAME="CareerAI"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
# For PostgreSQL (Production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_db
# For SQLite (Local Fallback - automatically used if DATABASE_URL is left empty or set to sqlite):
DATABASE_URL=sqlite:///./career_recommendation.db

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
